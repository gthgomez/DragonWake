# Server
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgres://tideforge:tideforge@localhost:5432/tideforge
SESSION_SECRET=change-me-in-production
DEV_FAST_TIME=1
NODE_ENV=development

# Admin gate for POST /api/v1/admin/grant, /sim/tick and dev citadel unlocks.
# Set a strong random value in any shared/production deployment; clients then
# present it via the x-admin-token header. Unset = dev-only (non-production).
# ADMIN_TOKEN=

# Set to 0 to disable the dev auto-unlock path in POST /api/v1/citadels/found
# DEV_CITADEL_UNLOCK=0

# Web (Vite)
VITE_API_URL=http://localhost:3001

# Alpha city raster art is quarantined candidate art, not production art.
# Set to 1 to serve it; unset/0 keeps the SVG glyph fallback.
# VITE_ALPHA_CITY_ART=1
