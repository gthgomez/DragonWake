{
  "name": "@dragonwake/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrate-cli.ts",
    "seed:demo": "tsx src/seed-demo-cli.ts",
    "accept": "vitest run src/acceptance.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@dragonwake/combat": "workspace:*",
    "@dragonwake/content": "workspace:*",
    "@dragonwake/shared": "workspace:*",
    "hono": "^4.7.5",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
